# Copy to .env only for local development. Never commit real tokens.
AGENTGUARD_API_TOKEN=replace-with-a-long-random-api-token
AGENTGUARD_APPROVAL_TOKEN=replace-with-a-separate-operator-approval-token
AGENTGUARD_DATA_DIR=.agentguard
# For real model-backed FRACTAL-Bench experiments, configure credentials in the
# underlying StegoPot workspace using its documented environment variable names.
# Do not place model API keys in this file or in experiment JSON/YAML configs.

# Optional LLM investigation advice (off by default). Keep actual API keys in the
# shell environment or a local untracked .env file; never commit real credentials.
# DEEPSEEK_API_KEY=
AGENTGUARD_LLM_BASE_URL=https://api.deepseek.com/v1
AGENTGUARD_LLM_MODEL=deepseek-chat
AGENTGUARD_LLM_TIMEOUT=20

# Optional authoritative causal-audit kernel (WARDEN).
# Leave blank to keep kernel endpoints explicitly not_configured.
AGENTGUARD_WARDEN_URL=http://127.0.0.1:8765
AGENTGUARD_WARDEN_TIMEOUT=15
