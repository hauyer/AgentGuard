{
  "$defs": {
    "ResearchArmDefinition": {
      "additionalProperties": false,
      "description": "An immutable planned condition; this does not submit or execute a run.",
      "properties": {
        "arm_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Arm Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "baseline",
            "treatment",
            "sham",
            "irrelevant",
            "randomization"
          ],
          "title": "Role",
          "type": "string"
        },
        "method_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Method Id",
          "type": "string"
        },
        "method_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Method Version",
          "type": "string"
        },
        "target_ref": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Ref"
        },
        "intervention_level": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intervention Level"
        },
        "control_arm_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Control Arm Id"
        },
        "parameter_ref": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameter Ref"
        },
        "parameter_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameter Sha256"
        }
      },
      "required": [
        "arm_id",
        "role",
        "method_id",
        "method_version"
      ],
      "title": "ResearchArmDefinition",
      "type": "object"
    },
    "WardenCaptureTarget": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "agent_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Agent Ids",
          "type": "array"
        },
        "module": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Module"
        },
        "layer": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Layer"
        },
        "component": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "resid_post",
          "title": "Component"
        },
        "token_policy": {
          "default": "last_token",
          "enum": [
            "all",
            "last_token",
            "mean_tokens"
          ],
          "title": "Token Policy",
          "type": "string"
        },
        "retain_gradient": {
          "default": false,
          "title": "Retain Gradient",
          "type": "boolean"
        }
      },
      "required": [
        "target_id",
        "agent_ids"
      ],
      "title": "WardenCaptureTarget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "maxLength": 240,
      "minLength": 8,
      "title": "Title",
      "type": "string"
    },
    "research_question": {
      "maxLength": 2000,
      "minLength": 12,
      "title": "Research Question",
      "type": "string"
    },
    "primary_hypothesis": {
      "maxLength": 2000,
      "minLength": 12,
      "title": "Primary Hypothesis",
      "type": "string"
    },
    "primary_outcome": {
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,79}$",
      "title": "Primary Outcome",
      "type": "string"
    },
    "primary_direction": {
      "default": "two_sided",
      "enum": [
        "increase",
        "decrease",
        "two_sided"
      ],
      "title": "Primary Direction",
      "type": "string"
    },
    "secondary_outcomes": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Secondary Outcomes",
      "type": "array"
    },
    "analysis_method": {
      "default": "clustered_paired",
      "enum": [
        "paired",
        "clustered_paired"
      ],
      "title": "Analysis Method",
      "type": "string"
    },
    "multiplicity_method": {
      "default": "holm",
      "enum": [
        "none",
        "holm",
        "benjamini_hochberg"
      ],
      "title": "Multiplicity Method",
      "type": "string"
    },
    "alpha": {
      "default": 0.05,
      "exclusiveMaximum": 0.5,
      "exclusiveMinimum": 0.0,
      "title": "Alpha",
      "type": "number"
    },
    "planned_pairs": {
      "maximum": 100000,
      "minimum": 2,
      "title": "Planned Pairs",
      "type": "integer"
    },
    "planned_case_families": {
      "maximum": 10000,
      "minimum": 2,
      "title": "Planned Case Families",
      "type": "integer"
    },
    "seed": {
      "default": 7,
      "title": "Seed",
      "type": "integer"
    },
    "matching_variables": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Matching Variables",
      "type": "array"
    },
    "inclusion_criteria": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Inclusion Criteria",
      "type": "array"
    },
    "exclusion_criteria": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Exclusion Criteria",
      "type": "array"
    },
    "stopping_rule": {
      "maxLength": 1000,
      "minLength": 8,
      "title": "Stopping Rule",
      "type": "string"
    },
    "missing_data_rule": {
      "maxLength": 1000,
      "minLength": 8,
      "title": "Missing Data Rule",
      "type": "string"
    },
    "deviations_policy": {
      "default": "Any deviation is logged with timestamp, rationale, and whether it was decided before outcome inspection.",
      "maxLength": 1000,
      "minLength": 8,
      "title": "Deviations Policy",
      "type": "string"
    },
    "protocol_version": {
      "default": "1",
      "maxLength": 80,
      "minLength": 1,
      "title": "Protocol Version",
      "type": "string"
    },
    "code_revision": {
      "default": "unspecified",
      "maxLength": 128,
      "minLength": 1,
      "title": "Code Revision",
      "type": "string"
    },
    "track": {
      "anyOf": [
        {
          "enum": [
            "mechanism_testbed",
            "live_steganography"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Track"
    },
    "protocol_ref": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Protocol Ref"
    },
    "dataset_ref": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset Ref"
    },
    "dataset_version": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset Version"
    },
    "split_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Split Sha256"
    },
    "case_family_ref": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Case Family Ref"
    },
    "model_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Id"
    },
    "model_revision": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Revision"
    },
    "tokenizer_revision": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tokenizer Revision"
    },
    "decoding_config_ref": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decoding Config Ref"
    },
    "probe_scope": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Probe Scope"
    },
    "probe_target": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Probe Target"
    },
    "probe_layer": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Probe Layer"
    },
    "probe_token": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Probe Token"
    },
    "probe_validation_ref": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Probe Validation Ref"
    },
    "label_semantics": {
      "anyOf": [
        {
          "enum": [
            "decoded_directive",
            "secret_bit",
            "misaligned"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Label Semantics"
    },
    "metric_definitions": {
      "additionalProperties": {
        "enum": [
          "SRR_ITT",
          "SRR_executed",
          "BER",
          "NORMAL_UTILITY",
          "CARRIER_DELIVERY_RATE",
          "FALSE_POSITIVE_COST",
          "LATENCY",
          "GPU_COST",
          "PROBE_SCORE",
          "CUSTOM"
        ],
        "type": "string"
      },
      "maxProperties": 31,
      "title": "Metric Definitions",
      "type": "object"
    },
    "metric_units": {
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 31,
      "title": "Metric Units",
      "type": "object"
    },
    "arms": {
      "items": {
        "$ref": "#/$defs/ResearchArmDefinition"
      },
      "maxItems": 64,
      "title": "Arms",
      "type": "array"
    },
    "warden_contract_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Warden Contract Id"
    },
    "warden_runtime_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Warden Runtime Id"
    },
    "warden_mode": {
      "anyOf": [
        {
          "enum": [
            "capture_only",
            "detection",
            "causal_audit",
            "defense_evaluation"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Warden Mode"
    },
    "warden_probe_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Warden Probe Id"
    },
    "warden_sae_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Warden Sae Id"
    },
    "warden_capture_targets": {
      "items": {
        "$ref": "#/$defs/WardenCaptureTarget"
      },
      "maxItems": 128,
      "title": "Warden Capture Targets",
      "type": "array"
    },
    "approval_requirements": {
      "items": {
        "enum": [
          "operator",
          "approval"
        ],
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Approval Requirements",
      "type": "array"
    },
    "supersedes_study_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Study Id"
    }
  },
  "required": [
    "title",
    "research_question",
    "primary_hypothesis",
    "primary_outcome",
    "planned_pairs",
    "planned_case_families",
    "inclusion_criteria",
    "stopping_rule",
    "missing_data_rule"
  ],
  "title": "StudyRegistrationRequest",
  "type": "object"
}
