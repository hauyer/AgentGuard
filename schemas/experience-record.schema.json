{
  "additionalProperties": false,
  "description": "A provenance-bearing case memory; defaults are quarantined from reward use.",
  "properties": {
    "schema_version": {
      "default": "0.2",
      "enum": [
        "0.1",
        "0.2"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "experience_id": {
      "title": "Experience Id",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "case_family": {
      "default": "unspecified",
      "title": "Case Family",
      "type": "string"
    },
    "dataset_partition": {
      "default": "held_out_family",
      "enum": [
        "training",
        "validation",
        "test",
        "held_out_family"
      ],
      "title": "Dataset Partition",
      "type": "string"
    },
    "risk_type": {
      "title": "Risk Type",
      "type": "string"
    },
    "source_system": {
      "default": "legacy",
      "enum": [
        "warden",
        "agentguard",
        "external",
        "legacy"
      ],
      "title": "Source System",
      "type": "string"
    },
    "source_run_status": {
      "default": "unknown",
      "enum": [
        "completed",
        "blocked",
        "failed",
        "cancelled",
        "unknown"
      ],
      "title": "Source Run Status",
      "type": "string"
    },
    "evidence_provenance_verified": {
      "default": false,
      "title": "Evidence Provenance Verified",
      "type": "boolean"
    },
    "audit_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audit Run Id"
    },
    "hypothesis": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hypothesis"
    },
    "hypothesis_summary": {
      "title": "Hypothesis Summary",
      "type": "string"
    },
    "selected_action": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Action"
    },
    "action_type": {
      "title": "Action Type",
      "type": "string"
    },
    "action_summary": {
      "title": "Action Summary",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "success",
        "partial",
        "failure",
        "inconclusive"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "observed_outcome": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Observed Outcome",
      "type": "object"
    },
    "evidence_grade": {
      "enum": [
        "observational",
        "synthetic",
        "interventional",
        "causal_validated"
      ],
      "title": "Evidence Grade",
      "type": "string"
    },
    "verification_level": {
      "anyOf": [
        {
          "enum": [
            "observational",
            "synthetic",
            "interventional",
            "causal_validated"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verification Level"
    },
    "verification_status": {
      "default": "unverified",
      "enum": [
        "unverified",
        "reviewed",
        "verified"
      ],
      "title": "Verification Status",
      "type": "string"
    },
    "repetitions": {
      "default": 1,
      "minimum": 1,
      "title": "Repetitions",
      "type": "integer"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "validation_notes": {
      "items": {
        "type": "string"
      },
      "title": "Validation Notes",
      "type": "array"
    },
    "benign_utility": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Benign Utility",
      "type": "object"
    },
    "execution_cost": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Execution Cost"
    },
    "metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Metrics",
      "type": "object"
    },
    "model_version": {
      "default": "unknown",
      "title": "Model Version",
      "type": "string"
    },
    "code_version": {
      "default": "unknown",
      "title": "Code Version",
      "type": "string"
    },
    "policy_version": {
      "default": "unknown",
      "title": "Policy Version",
      "type": "string"
    },
    "reproducibility_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reproducibility Hash"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    },
    "allow_auto_recommendation": {
      "default": false,
      "title": "Allow Auto Recommendation",
      "type": "boolean"
    },
    "verified_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verified At"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    }
  },
  "required": [
    "scenario_id",
    "risk_type",
    "hypothesis_summary",
    "action_type",
    "action_summary",
    "outcome",
    "evidence_grade"
  ],
  "title": "ExperienceRecord",
  "type": "object"
}
