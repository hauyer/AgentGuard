{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "protocol_fingerprint_before": {
      "maxLength": 256,
      "minLength": 8,
      "title": "Protocol Fingerprint Before",
      "type": "string"
    },
    "protocol_fingerprint_after": {
      "maxLength": 256,
      "minLength": 8,
      "title": "Protocol Fingerprint After",
      "type": "string"
    },
    "model_state_before": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Model State Before",
      "type": "string"
    },
    "model_state_after": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Model State After",
      "type": "string"
    },
    "contributions_before": {
      "additionalProperties": {
        "type": "number"
      },
      "maxProperties": 10000,
      "minProperties": 1,
      "title": "Contributions Before",
      "type": "object"
    },
    "contributions_after": {
      "additionalProperties": {
        "type": "number"
      },
      "maxProperties": 10000,
      "minProperties": 1,
      "title": "Contributions After",
      "type": "object"
    },
    "top_k": {
      "default": 5,
      "maximum": 1000,
      "minimum": 1,
      "title": "Top K",
      "type": "integer"
    },
    "evidence_mode": {
      "default": "observed",
      "enum": [
        "synthetic",
        "observed",
        "measured"
      ],
      "title": "Evidence Mode",
      "type": "string"
    },
    "source_artifact_refs": {
      "items": {
        "type": "string"
      },
      "maxItems": 1000,
      "title": "Source Artifact Refs",
      "type": "array"
    }
  },
  "required": [
    "protocol_fingerprint_before",
    "protocol_fingerprint_after",
    "model_state_before",
    "model_state_after",
    "contributions_before",
    "contributions_after"
  ],
  "title": "PathShiftAnalysisRequest",
  "type": "object"
}
