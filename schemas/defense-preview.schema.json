{
  "$defs": {
    "DefenseCandidate": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "target_type": {
          "enum": [
            "message",
            "tool_call",
            "tool_result",
            "activation"
          ],
          "title": "Target Type",
          "type": "string"
        },
        "target_ref": {
          "title": "Target Ref",
          "type": "string"
        },
        "operation": {
          "enum": [
            "block",
            "replace",
            "ablate",
            "patch"
          ],
          "title": "Operation",
          "type": "string"
        },
        "scope": {
          "default": "isolated_test_environment",
          "enum": [
            "isolated_test_environment",
            "synthetic_demo"
          ],
          "title": "Scope",
          "type": "string"
        },
        "expected_risk_reduction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Expected Risk Reduction",
          "type": "number"
        },
        "estimated_benign_utility_cost": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Estimated Benign Utility Cost",
          "type": "number"
        },
        "reversibility": {
          "default": "reversible",
          "enum": [
            "reversible",
            "partially_reversible",
            "irreversible"
          ],
          "title": "Reversibility",
          "type": "string"
        },
        "approval_required": {
          "default": true,
          "title": "Approval Required",
          "type": "boolean"
        },
        "risk_type": {
          "default": "unknown",
          "title": "Risk Type",
          "type": "string"
        },
        "evidence_level": {
          "default": "observational",
          "enum": [
            "synthetic",
            "observational",
            "interventional",
            "causal_validated"
          ],
          "title": "Evidence Level",
          "type": "string"
        },
        "evidence_reliability": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Evidence Reliability",
          "type": "number"
        },
        "experience_refs": {
          "items": {
            "type": "string"
          },
          "title": "Experience Refs",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "execution_supported": {
          "default": false,
          "title": "Execution Supported",
          "type": "boolean"
        },
        "execution_provider": {
          "default": "unknown",
          "title": "Execution Provider",
          "type": "string"
        },
        "priority_score": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Priority Score",
          "type": "number"
        },
        "priority_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Priority Reasons",
          "type": "array"
        },
        "status": {
          "default": "proposed",
          "enum": [
            "proposed",
            "awaiting_approval",
            "approved",
            "submitted",
            "executed",
            "verification_pending",
            "verified",
            "rejected",
            "unsupported",
            "failed",
            "rolled_back"
          ],
          "title": "Status",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "finding_id",
        "target_type",
        "target_ref",
        "operation",
        "expected_risk_reduction",
        "estimated_benign_utility_cost",
        "rationale"
      ],
      "title": "DefenseCandidate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "default": "preview_only",
      "enum": [
        "preview_only",
        "blocked",
        "unsupported"
      ],
      "title": "Status",
      "type": "string"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/DefenseCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "policy_notes": {
      "items": {
        "type": "string"
      },
      "title": "Policy Notes",
      "type": "array"
    },
    "execution_performed": {
      "default": false,
      "title": "Execution Performed",
      "type": "boolean"
    },
    "evidence_mode": {
      "default": "observed",
      "enum": [
        "synthetic",
        "observed",
        "measured"
      ],
      "title": "Evidence Mode",
      "type": "string"
    }
  },
  "required": [
    "run_id"
  ],
  "title": "DefensePreview",
  "type": "object"
}
