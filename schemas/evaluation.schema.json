{
  "$defs": {
    "MetricValue": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        },
        "source": {
          "default": "unknown",
          "title": "Source",
          "type": "string"
        },
        "evidence_mode": {
          "default": "observed",
          "enum": [
            "synthetic",
            "observed",
            "measured"
          ],
          "title": "Evidence Mode",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "MetricValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "experiment_id": {
      "title": "Experiment Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "evidence_mode": {
      "default": "observed",
      "enum": [
        "synthetic",
        "observed",
        "measured"
      ],
      "title": "Evidence Mode",
      "type": "string"
    },
    "baseline_metrics": {
      "additionalProperties": {
        "$ref": "#/$defs/MetricValue"
      },
      "title": "Baseline Metrics",
      "type": "object"
    },
    "post_intervention_metrics": {
      "additionalProperties": {
        "$ref": "#/$defs/MetricValue"
      },
      "title": "Post Intervention Metrics",
      "type": "object"
    },
    "deltas": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Deltas",
      "type": "object"
    },
    "benign_utility_preserved": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Benign Utility Preserved"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "sample_size": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sample Size"
    },
    "repetitions": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repetitions"
    },
    "confidence_intervals": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "number"
        },
        "type": "object"
      },
      "title": "Confidence Intervals",
      "type": "object"
    },
    "statistical_tests": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "title": "Statistical Tests",
      "type": "object"
    }
  },
  "required": [
    "experiment_id",
    "status"
  ],
  "title": "EvaluationReport",
  "type": "object"
}
