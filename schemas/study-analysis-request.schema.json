{
  "$defs": {
    "OutcomePairs": {
      "additionalProperties": false,
      "properties": {
        "control": {
          "items": {
            "type": "number"
          },
          "maxItems": 100000,
          "minItems": 2,
          "title": "Control",
          "type": "array"
        },
        "treatment": {
          "items": {
            "type": "number"
          },
          "maxItems": 100000,
          "minItems": 2,
          "title": "Treatment",
          "type": "array"
        },
        "case_families": {
          "items": {
            "type": "string"
          },
          "maxItems": 100000,
          "minItems": 2,
          "title": "Case Families",
          "type": "array"
        }
      },
      "required": [
        "control",
        "treatment",
        "case_families"
      ],
      "title": "OutcomePairs",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "outcomes": {
      "additionalProperties": {
        "$ref": "#/$defs/OutcomePairs"
      },
      "maxProperties": 31,
      "minProperties": 1,
      "title": "Outcomes",
      "type": "object"
    },
    "evidence_mode": {
      "default": "observed",
      "enum": [
        "synthetic",
        "observed",
        "measured"
      ],
      "title": "Evidence Mode",
      "type": "string"
    },
    "source_artifact_refs": {
      "items": {
        "type": "string"
      },
      "maxItems": 1000,
      "title": "Source Artifact Refs",
      "type": "array"
    },
    "data_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Data Sha256"
    },
    "bootstrap_draws": {
      "default": 5000,
      "maximum": 100000,
      "minimum": 100,
      "title": "Bootstrap Draws",
      "type": "integer"
    },
    "permutation_draws": {
      "default": 20000,
      "maximum": 1000000,
      "minimum": 1000,
      "title": "Permutation Draws",
      "type": "integer"
    }
  },
  "required": [
    "outcomes"
  ],
  "title": "StudyAnalysisRequest",
  "type": "object"
}
