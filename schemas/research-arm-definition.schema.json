{
  "additionalProperties": false,
  "description": "An immutable planned condition; this does not submit or execute a run.",
  "properties": {
    "arm_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Arm Id",
      "type": "string"
    },
    "role": {
      "enum": [
        "baseline",
        "treatment",
        "sham",
        "irrelevant",
        "randomization"
      ],
      "title": "Role",
      "type": "string"
    },
    "method_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Method Id",
      "type": "string"
    },
    "method_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Method Version",
      "type": "string"
    },
    "target_ref": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Ref"
    },
    "intervention_level": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Intervention Level"
    },
    "control_arm_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Control Arm Id"
    },
    "parameter_ref": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parameter Ref"
    },
    "parameter_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parameter Sha256"
    }
  },
  "required": [
    "arm_id",
    "role",
    "method_id",
    "method_version"
  ],
  "title": "ResearchArmDefinition",
  "type": "object"
}
