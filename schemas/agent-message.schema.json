{
  "additionalProperties": false,
  "description": "Typed, auditable message between role-separated AgentGuard agents.",
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "message_id": {
      "title": "Message Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "sender_role": {
      "enum": [
        "supervisor",
        "trace_analyst",
        "causal_investigator",
        "defense_planner",
        "policy_engine",
        "runtime",
        "evaluator",
        "verifier",
        "memory_agent"
      ],
      "title": "Sender Role",
      "type": "string"
    },
    "recipient_role": {
      "enum": [
        "supervisor",
        "trace_analyst",
        "causal_investigator",
        "defense_planner",
        "policy_engine",
        "runtime",
        "evaluator",
        "verifier",
        "memory_agent"
      ],
      "title": "Recipient Role",
      "type": "string"
    },
    "message_type": {
      "title": "Message Type",
      "type": "string"
    },
    "payload_schema_version": {
      "default": "0.1",
      "title": "Payload Schema Version",
      "type": "string"
    },
    "payload": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        ]
      },
      "title": "Payload",
      "type": "object"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "deadline": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deadline"
    },
    "policy_context": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "title": "Policy Context",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "sender_role",
    "recipient_role",
    "message_type"
  ],
  "title": "AgentMessage",
  "type": "object"
}
