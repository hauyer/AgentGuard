{
  "$defs": {
    "CausalValidationCriteria": {
      "additionalProperties": false,
      "description": "Auditable experiment records required before evidence can be called causal.\n\nThis structure records what was reviewed. Its fields are not, by themselves,\nproof that the runs, artifacts, or reviewer are authentic; the Evidence Gateway\nmust validate those references against a trusted source before emitting a\ncausal grade.",
      "properties": {
        "schema_version": {
          "const": "0.3",
          "default": "0.3",
          "title": "Schema Version",
          "type": "string"
        },
        "independent_repetitions": {
          "minimum": 2,
          "title": "Independent Repetitions",
          "type": "integer"
        },
        "independent_run_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 2,
          "title": "Independent Run Ids",
          "type": "array"
        },
        "sample_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 2,
          "title": "Sample Ids",
          "type": "array"
        },
        "independent_case_family_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 2,
          "title": "Independent Case Family Ids",
          "type": "array"
        },
        "experiment_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Experiment Config Sha256",
          "type": "string"
        },
        "preregistered_design_artifact_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Preregistered Design Artifact Ref",
          "type": "string"
        },
        "preregistered_design_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Preregistered Design Sha256",
          "type": "string"
        },
        "control_condition": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Control Condition",
          "type": "string"
        },
        "treatment_condition": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Treatment Condition",
          "type": "string"
        },
        "matched_control_passed": {
          "title": "Matched Control Passed",
          "type": "boolean"
        },
        "matched_control_artifact_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Matched Control Artifact Ref",
          "type": "string"
        },
        "sham_control_passed": {
          "title": "Sham Control Passed",
          "type": "boolean"
        },
        "sham_control_artifact_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Sham Control Artifact Ref",
          "type": "string"
        },
        "negative_control_passed": {
          "title": "Negative Control Passed",
          "type": "boolean"
        },
        "negative_control_artifact_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Negative Control Artifact Ref",
          "type": "string"
        },
        "unrelated_position_control_passed": {
          "title": "Unrelated Position Control Passed",
          "type": "boolean"
        },
        "unrelated_position_control_artifact_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Unrelated Position Control Artifact Ref",
          "type": "string"
        },
        "randomization_or_permutation_baseline": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Randomization Or Permutation Baseline",
          "type": "string"
        },
        "randomization_or_permutation_baseline_artifact_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Randomization Or Permutation Baseline Artifact Ref",
          "type": "string"
        },
        "benign_utility_measured": {
          "title": "Benign Utility Measured",
          "type": "boolean"
        },
        "utility_artifact_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Utility Artifact Ref",
          "type": "string"
        },
        "control_output_artifact_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Control Output Artifact Ref",
          "type": "string"
        },
        "treatment_output_artifact_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Treatment Output Artifact Ref",
          "type": "string"
        },
        "sham_output_artifact_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Sham Output Artifact Ref",
          "type": "string"
        },
        "negative_control_output_artifact_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Negative Control Output Artifact Ref",
          "type": "string"
        },
        "unrelated_position_output_artifact_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Unrelated Position Output Artifact Ref",
          "type": "string"
        },
        "execution_log_artifact_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Execution Log Artifact Ref",
          "type": "string"
        },
        "execution_log_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Execution Log Sha256",
          "type": "string"
        },
        "intervention_parameters_artifact_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Intervention Parameters Artifact Ref",
          "type": "string"
        },
        "intervention_parameters_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Intervention Parameters Sha256",
          "type": "string"
        },
        "evaluator_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Evaluator Version",
          "type": "string"
        },
        "evaluator_artifact_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Evaluator Artifact Ref",
          "type": "string"
        },
        "primary_outcome_metric": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Primary Outcome Metric",
          "type": "string"
        },
        "effect_size": {
          "title": "Effect Size",
          "type": "number"
        },
        "confidence_interval_lower": {
          "title": "Confidence Interval Lower",
          "type": "number"
        },
        "confidence_interval_upper": {
          "title": "Confidence Interval Upper",
          "type": "number"
        },
        "multiple_comparison_method": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Multiple Comparison Method",
          "type": "string"
        },
        "alpha": {
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Alpha",
          "type": "number"
        },
        "statistical_report_artifact_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Statistical Report Artifact Ref",
          "type": "string"
        },
        "artifact_hashes_verified": {
          "title": "Artifact Hashes Verified",
          "type": "boolean"
        },
        "alternative_explanations_reviewed": {
          "title": "Alternative Explanations Reviewed",
          "type": "boolean"
        },
        "alternative_explanations_review_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Alternative Explanations Review Ref",
          "type": "string"
        },
        "methodology_review_record_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Methodology Review Record Ref",
          "type": "string"
        },
        "methodology_reviewer_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Methodology Reviewer Id",
          "type": "string"
        }
      },
      "required": [
        "independent_repetitions",
        "independent_run_ids",
        "sample_ids",
        "independent_case_family_ids",
        "experiment_config_sha256",
        "preregistered_design_artifact_ref",
        "preregistered_design_sha256",
        "control_condition",
        "treatment_condition",
        "matched_control_passed",
        "matched_control_artifact_ref",
        "sham_control_passed",
        "sham_control_artifact_ref",
        "negative_control_passed",
        "negative_control_artifact_ref",
        "unrelated_position_control_passed",
        "unrelated_position_control_artifact_ref",
        "randomization_or_permutation_baseline",
        "randomization_or_permutation_baseline_artifact_ref",
        "benign_utility_measured",
        "utility_artifact_ref",
        "control_output_artifact_ref",
        "treatment_output_artifact_ref",
        "sham_output_artifact_ref",
        "negative_control_output_artifact_ref",
        "unrelated_position_output_artifact_ref",
        "execution_log_artifact_ref",
        "execution_log_sha256",
        "intervention_parameters_artifact_ref",
        "intervention_parameters_sha256",
        "evaluator_version",
        "evaluator_artifact_ref",
        "primary_outcome_metric",
        "effect_size",
        "confidence_interval_lower",
        "confidence_interval_upper",
        "multiple_comparison_method",
        "alpha",
        "statistical_report_artifact_ref",
        "artifact_hashes_verified",
        "alternative_explanations_reviewed",
        "alternative_explanations_review_ref",
        "methodology_review_record_ref",
        "methodology_reviewer_id"
      ],
      "title": "CausalValidationCriteria",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Evidence Gateway view with source, execution and method status kept distinct.",
  "properties": {
    "schema_version": {
      "const": "0.2",
      "default": "0.2",
      "title": "Schema Version",
      "type": "string"
    },
    "evidence_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Evidence Id",
      "type": "string"
    },
    "source_system": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Source System",
      "type": "string"
    },
    "source_type": {
      "default": "unknown",
      "enum": [
        "synthetic",
        "stub",
        "warden_api",
        "agentguard_local",
        "historical_record",
        "unknown"
      ],
      "title": "Source Type",
      "type": "string"
    },
    "production_phase": {
      "default": "unknown",
      "title": "Production Phase",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "experiment_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Experiment Id"
    },
    "model_id": {
      "default": "unknown",
      "title": "Model Id",
      "type": "string"
    },
    "data_version": {
      "default": "unknown",
      "title": "Data Version",
      "type": "string"
    },
    "artifact_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Artifact Hashes",
      "type": "object"
    },
    "warden_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Warden Run Id"
    },
    "warden_plan_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Warden Plan Id"
    },
    "target_type": {
      "anyOf": [
        {
          "enum": [
            "message",
            "tool_call",
            "tool_result",
            "activation"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Type"
    },
    "target_ref": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Ref"
    },
    "scenario_id": {
      "default": "unknown",
      "title": "Scenario Id",
      "type": "string"
    },
    "artifact_refs": {
      "items": {
        "type": "string"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "evidence_type": {
      "enum": [
        "observation",
        "finding",
        "hypothesis",
        "experiment_design",
        "intervention",
        "defense",
        "evaluation",
        "run_summary",
        "note"
      ],
      "title": "Evidence Type",
      "type": "string"
    },
    "evidence_level": {
      "enum": [
        "synthetic",
        "observational",
        "interventional",
        "causal_validated"
      ],
      "title": "Evidence Level",
      "type": "string"
    },
    "risk_type": {
      "default": "unknown",
      "title": "Risk Type",
      "type": "string"
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "verification_status": {
      "default": "unverified",
      "enum": [
        "verified",
        "unverified",
        "blocked",
        "failed",
        "unsupported"
      ],
      "title": "Verification Status",
      "type": "string"
    },
    "content_integrity_status": {
      "default": "unverified",
      "enum": [
        "verified",
        "unverified",
        "failed"
      ],
      "title": "Content Integrity Status",
      "type": "string"
    },
    "source_authenticity_status": {
      "default": "unknown",
      "enum": [
        "verified",
        "unverified",
        "unknown"
      ],
      "title": "Source Authenticity Status",
      "type": "string"
    },
    "methodology_review_status": {
      "default": "unknown",
      "enum": [
        "verified",
        "unverified",
        "unknown"
      ],
      "title": "Methodology Review Status",
      "type": "string"
    },
    "run_status": {
      "default": "unknown",
      "enum": [
        "completed",
        "partial",
        "failed",
        "blocked",
        "unknown"
      ],
      "title": "Run Status",
      "type": "string"
    },
    "model_version": {
      "default": "unknown",
      "title": "Model Version",
      "type": "string"
    },
    "scenario_version": {
      "default": "unknown",
      "title": "Scenario Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "causal_validation": {
      "anyOf": [
        {
          "$ref": "#/$defs/CausalValidationCriteria"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metadata_available": {
      "default": true,
      "title": "Metadata Available",
      "type": "boolean"
    },
    "content_access_supported": {
      "default": false,
      "title": "Content Access Supported",
      "type": "boolean"
    },
    "integrity_verified": {
      "default": false,
      "title": "Integrity Verified",
      "type": "boolean"
    },
    "access_restriction": {
      "default": "read_only_reference",
      "enum": [
        "read_only_reference",
        "local_verified_read",
        "operator_only"
      ],
      "title": "Access Restriction",
      "type": "string"
    }
  },
  "required": [
    "evidence_id",
    "source_system",
    "evidence_type",
    "evidence_level"
  ],
  "title": "GovernedEvidence",
  "type": "object"
}
