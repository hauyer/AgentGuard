{
  "$defs": {
    "CausalValidationCriteria": {
      "additionalProperties": false,
      "description": "Auditable experiment records required before evidence can be called causal.\n\nThis structure records what was reviewed. Its fields are not, by themselves,\nproof that the runs, artifacts, or reviewer are authentic; the Evidence Gateway\nmust validate those references against a trusted source before emitting a\ncausal grade.",
      "properties": {
        "schema_version": {
          "const": "0.2",
          "default": "0.2",
          "title": "Schema Version",
          "type": "string"
        },
        "independent_repetitions": {
          "minimum": 2,
          "title": "Independent Repetitions",
          "type": "integer"
        },
        "independent_run_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 2,
          "title": "Independent Run Ids",
          "type": "array"
        },
        "sample_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 2,
          "title": "Sample Ids",
          "type": "array"
        },
        "experiment_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Experiment Config Sha256",
          "type": "string"
        },
        "matched_control_passed": {
          "title": "Matched Control Passed",
          "type": "boolean"
        },
        "matched_control_artifact_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Matched Control Artifact Ref",
          "type": "string"
        },
        "negative_control_passed": {
          "title": "Negative Control Passed",
          "type": "boolean"
        },
        "negative_control_artifact_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Negative Control Artifact Ref",
          "type": "string"
        },
        "benign_utility_measured": {
          "title": "Benign Utility Measured",
          "type": "boolean"
        },
        "utility_artifact_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Utility Artifact Ref",
          "type": "string"
        },
        "artifact_hashes_verified": {
          "title": "Artifact Hashes Verified",
          "type": "boolean"
        },
        "alternative_explanations_reviewed": {
          "title": "Alternative Explanations Reviewed",
          "type": "boolean"
        },
        "alternative_explanations_review_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Alternative Explanations Review Ref",
          "type": "string"
        },
        "methodology_review_record_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Methodology Review Record Ref",
          "type": "string"
        },
        "methodology_reviewer_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Methodology Reviewer Id",
          "type": "string"
        }
      },
      "required": [
        "independent_repetitions",
        "independent_run_ids",
        "sample_ids",
        "experiment_config_sha256",
        "matched_control_passed",
        "matched_control_artifact_ref",
        "negative_control_passed",
        "negative_control_artifact_ref",
        "benign_utility_measured",
        "utility_artifact_ref",
        "artifact_hashes_verified",
        "alternative_explanations_reviewed",
        "alternative_explanations_review_ref",
        "methodology_review_record_ref",
        "methodology_reviewer_id"
      ],
      "title": "CausalValidationCriteria",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Evidence Gateway view with source, execution and method status kept distinct.",
  "properties": {
    "schema_version": {
      "const": "0.2",
      "default": "0.2",
      "title": "Schema Version",
      "type": "string"
    },
    "evidence_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Evidence Id",
      "type": "string"
    },
    "source_system": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Source System",
      "type": "string"
    },
    "warden_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Warden Run Id"
    },
    "warden_plan_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Warden Plan Id"
    },
    "target_type": {
      "anyOf": [
        {
          "enum": [
            "message",
            "tool_call",
            "tool_result",
            "activation"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Type"
    },
    "target_ref": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Ref"
    },
    "scenario_id": {
      "default": "unknown",
      "title": "Scenario Id",
      "type": "string"
    },
    "artifact_refs": {
      "items": {
        "type": "string"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "evidence_type": {
      "enum": [
        "observation",
        "finding",
        "hypothesis",
        "experiment_design",
        "intervention",
        "defense",
        "evaluation",
        "run_summary",
        "note"
      ],
      "title": "Evidence Type",
      "type": "string"
    },
    "evidence_level": {
      "enum": [
        "synthetic",
        "observational",
        "interventional",
        "causal_validated"
      ],
      "title": "Evidence Level",
      "type": "string"
    },
    "risk_type": {
      "default": "unknown",
      "title": "Risk Type",
      "type": "string"
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "verification_status": {
      "default": "unverified",
      "enum": [
        "verified",
        "unverified",
        "blocked",
        "failed",
        "unsupported"
      ],
      "title": "Verification Status",
      "type": "string"
    },
    "content_integrity_status": {
      "default": "unverified",
      "enum": [
        "verified",
        "unverified",
        "failed"
      ],
      "title": "Content Integrity Status",
      "type": "string"
    },
    "source_authenticity_status": {
      "default": "unknown",
      "enum": [
        "verified",
        "unverified",
        "unknown"
      ],
      "title": "Source Authenticity Status",
      "type": "string"
    },
    "methodology_review_status": {
      "default": "unknown",
      "enum": [
        "verified",
        "unverified",
        "unknown"
      ],
      "title": "Methodology Review Status",
      "type": "string"
    },
    "run_status": {
      "default": "unknown",
      "enum": [
        "completed",
        "partial",
        "failed",
        "blocked",
        "unknown"
      ],
      "title": "Run Status",
      "type": "string"
    },
    "model_version": {
      "default": "unknown",
      "title": "Model Version",
      "type": "string"
    },
    "scenario_version": {
      "default": "unknown",
      "title": "Scenario Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "causal_validation": {
      "anyOf": [
        {
          "$ref": "#/$defs/CausalValidationCriteria"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metadata_available": {
      "default": true,
      "title": "Metadata Available",
      "type": "boolean"
    },
    "content_access_supported": {
      "default": false,
      "title": "Content Access Supported",
      "type": "boolean"
    },
    "integrity_verified": {
      "default": false,
      "title": "Integrity Verified",
      "type": "boolean"
    },
    "access_restriction": {
      "default": "read_only_reference",
      "enum": [
        "read_only_reference",
        "local_verified_read",
        "operator_only"
      ],
      "title": "Access Restriction",
      "type": "string"
    }
  },
  "required": [
    "evidence_id",
    "source_system",
    "evidence_type",
    "evidence_level"
  ],
  "title": "GovernedEvidence",
  "type": "object"
}
