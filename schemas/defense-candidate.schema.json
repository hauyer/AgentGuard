      "title": "Reversibility",
      "type": "string"
    },
    "approval_required": {
      "default": true,
      "title": "Approval Required",
      "type": "boolean"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "finding_id",
    "target_type",
    "target_ref",
    "operation",
    "expected_risk_reduction",
    "estimated_benign_utility_cost",
    "rationale"
