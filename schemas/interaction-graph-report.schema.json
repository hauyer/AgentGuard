{
  "$defs": {
    "CandidatePath": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "nodes": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Nodes",
          "type": "array"
        },
        "edge_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Edge Refs",
          "type": "array"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "nodes",
        "edge_refs",
        "score",
        "rationale"
      ],
      "title": "CandidatePath",
      "type": "object"
    },
    "InteractionEdge": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "event_type": {
          "title": "Event Type",
          "type": "string"
        },
        "target_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Ref"
        },
        "risk_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Risk Score",
          "type": "number"
        },
        "risk_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Risk Reasons",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "edge_id",
        "source",
        "target",
        "event_type",
        "risk_score"
      ],
      "title": "InteractionEdge",
      "type": "object"
    },
    "InteractionNode": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "node_type": {
          "default": "agent",
          "enum": [
            "agent",
            "tool",
            "unknown"
          ],
          "title": "Node Type",
          "type": "string"
        },
        "event_count": {
          "default": 0,
          "minimum": 0,
          "title": "Event Count",
          "type": "integer"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        }
      },
      "required": [
        "node_id"
      ],
      "title": "InteractionNode",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/InteractionNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/InteractionEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "candidate_paths": {
      "items": {
        "$ref": "#/$defs/CandidatePath"
      },
      "title": "Candidate Paths",
      "type": "array"
    },
    "node_count": {
      "default": 0,
      "minimum": 0,
      "title": "Node Count",
      "type": "integer"
    },
    "edge_count": {
      "default": 0,
      "minimum": 0,
      "title": "Edge Count",
      "type": "integer"
    },
    "suspicious_edge_count": {
      "default": 0,
      "minimum": 0,
      "title": "Suspicious Edge Count",
      "type": "integer"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "title": "InteractionGraphReport",
  "type": "object"
}
