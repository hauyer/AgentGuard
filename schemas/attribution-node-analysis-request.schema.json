      "anyOf": [
        {
          "items": {
            "type": "number"
          },
          "maxItems": 100000,
          "minItems": 2,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Baseline Benign Utility"
    },
    "intervened_benign_utility": {
      "anyOf": [
        {
          "items": {
            "type": "number"
