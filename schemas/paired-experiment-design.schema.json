{
  "additionalProperties": false,
  "description": "Reproducible paired treatment/control design metadata.",
  "properties": {
    "schema_version": {
      "default": "0.2",
      "enum": [
        "0.1",
        "0.2"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "design_id": {
      "title": "Design Id",
      "type": "string"
    },
    "experiment_id": {
      "title": "Experiment Id",
      "type": "string"
    },
    "hypothesis_id": {
      "title": "Hypothesis Id",
      "type": "string"
    },
    "design_type": {
      "default": "paired_replay",
      "enum": [
        "paired_replay",
        "negative_control",
        "factorial"
      ],
      "title": "Design Type",
      "type": "string"
    },
    "treatment_operation": {
      "title": "Treatment Operation",
      "type": "string"
    },
    "control_operation": {
      "default": "no_intervention",
      "title": "Control Operation",
      "type": "string"
    },
    "sham_control_operation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sham Control Operation"
    },
    "negative_control_operation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Negative Control Operation"
    },
    "scenario_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scenario Id"
    },
    "model_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Revision"
    },
    "decoding_settings": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "title": "Decoding Settings",
      "type": "object"
    },
    "control_condition": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Control Condition"
    },
    "treatment_condition": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Treatment Condition"
    },
    "candidate_target_type": {
      "anyOf": [
        {
          "enum": [
            "message",
            "tool_call",
            "tool_result",
            "activation"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Target Type"
    },
    "candidate_target_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Target Ref"
    },
    "candidate_component": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Component"
    },
    "token_position": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Token Position"
    },
    "utility_metric": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Utility Metric"
    },
    "secret_recovery_metric": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Secret Recovery Metric"
    },
    "stopping_condition": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stopping Condition"
    },
    "exclusion_rules": {
      "items": {
        "type": "string"
      },
      "title": "Exclusion Rules",
      "type": "array"
    },
    "randomization_or_permutation_baseline": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Randomization Or Permutation Baseline"
    },
    "hidden_truth_excluded_from_model_input": {
      "default": false,
      "title": "Hidden Truth Excluded From Model Input",
      "type": "boolean"
    },
    "independent_case_family_ids": {
      "items": {
        "type": "string"
      },
      "title": "Independent Case Family Ids",
      "type": "array"
    },
    "preregistration_artifact_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preregistration Artifact Ref"
    },
    "preregistration_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preregistration Sha256"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "seeds": {
      "items": {
        "type": "integer"
      },
      "minItems": 2,
      "title": "Seeds",
      "type": "array"
    },
    "repetitions": {
      "maximum": 10000,
      "minimum": 2,
      "title": "Repetitions",
      "type": "integer"
    },
    "matched_on": {
      "items": {
        "type": "string"
      },
      "title": "Matched On",
      "type": "array"
    },
    "primary_metric": {
      "default": "risk_exposure",
      "title": "Primary Metric",
      "type": "string"
    },
    "secondary_metrics": {
      "items": {
        "type": "string"
      },
      "title": "Secondary Metrics",
      "type": "array"
    },
    "preregistered": {
      "default": false,
      "title": "Preregistered",
      "type": "boolean"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    }
  },
  "required": [
    "experiment_id",
    "hypothesis_id",
    "treatment_operation",
    "seed",
    "seeds",
    "repetitions"
  ],
  "title": "PairedExperimentDesign",
  "type": "object"
}
