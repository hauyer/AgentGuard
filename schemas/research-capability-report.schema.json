{
  "$defs": {
    "ResearchCapabilityItem": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "enum": [
            "research_dataset_mechanism",
            "sender_receiver_baseline",
            "agent_isolation",
            "message_block",
            "message_replace",
            "leace_fit_apply",
            "activation_patch",
            "residual_edge_patch",
            "probe_training",
            "persistent_run",
            "artifact_content_read"
          ],
          "title": "Capability",
          "type": "string"
        },
        "status": {
          "enum": [
            "SUPPORTED_AND_READY",
            "SUPPORTED_BUT_BLOCKED",
            "UNSUPPORTED",
            "UNAVAILABLE",
            "UNKNOWN"
          ],
          "title": "Status",
          "type": "string"
        },
        "blockers": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Blockers",
          "type": "array"
        },
        "source_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version"
        },
        "source_api_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Api Version"
        },
        "advertised_by_warden": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Advertised By Warden"
        },
        "observed_at": {
          "minLength": 1,
          "title": "Observed At",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Evidence Refs",
          "type": "array"
        },
        "operation_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        },
        "contract_ref": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contract Ref"
        }
      },
      "required": [
        "capability",
        "status",
        "observed_at"
      ],
      "title": "ResearchCapabilityItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A status projection; support is never inferred from API health alone.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "backend_status": {
      "enum": [
        "available",
        "unavailable",
        "blocked",
        "unknown",
        "not_configured"
      ],
      "title": "Backend Status",
      "type": "string"
    },
    "source": {
      "default": "agentguard:warden-research-capability-check",
      "title": "Source",
      "type": "string"
    },
    "source_version": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Version"
    },
    "source_api_version": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Api Version"
    },
    "observed_at": {
      "minLength": 1,
      "title": "Observed At",
      "type": "string"
    },
    "capabilities": {
      "items": {
        "$ref": "#/$defs/ResearchCapabilityItem"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Capabilities",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "backend_status",
    "observed_at",
    "capabilities"
  ],
  "title": "ResearchCapabilityReport",
  "type": "object"
}
